# --- Speech-to-Text (faster-whisper, runs 100% locally/offline) ---
WHISPER_MODEL_SIZE=base
# tiny/base = fast, lower accuracy. small/medium = slower, more accurate.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- LLM Provider (for live notes + Q&A) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Embeddings (for transcript RAG) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Live summarization cadence ---
SUMMARY_INTERVAL_WORDS=120
# generate a new bullet-note batch every ~N new words transcribed

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=sqlite:///./lectures.db
